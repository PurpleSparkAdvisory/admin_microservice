# Supabase (server-side only - the service role key bypasses RLS, never expose it to the browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin login shared by managers
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
SESSION_SECRET=generate-a-long-random-string

# Optional - defaults to 3000 locally; Railway sets PORT automatically
PORT=3000
